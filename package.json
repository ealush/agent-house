{
  "name": "ah",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Hub: a web control plane for persistent tmux shells and coding-agent sessions",
  "type": "module",
  "bin": {
    "ah": "./bin/ah.js"
  },
  "scripts": {
    "dev": "node --watch server/main.ts & vite",
    "build": "vite build",
    "start": "node server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/*.test.ts"
  },
  "engines": {
    "node": ">=23.6"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
