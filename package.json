{
  "name": "agent-house",
  "private": true,
  "description": "Agent House: the ah server, web client and CLI (apps/server) and the native app (apps/ios)",
  "type": "module",
  "bin": {
    "ah": "./bin/ah.js"
  },
  "scripts": {
    "build": "pnpm install --frozen-lockfile && pnpm --dir apps/server run build",
    "dev": "pnpm --dir apps/server run dev",
    "start": "pnpm --dir apps/server run start",
    "serve": "pnpm --dir apps/server run serve",
    "setup:tailscale": "pnpm --dir apps/server run setup:tailscale",
    "typecheck": "pnpm --dir apps/server run typecheck",
    "test": "pnpm --dir apps/server run test",
    "test:security": "pnpm --dir apps/server run test:security",
    "test:ui": "pnpm --dir apps/server run test:ui",
    "prisma:check": "pnpm --dir apps/server run prisma:check",
    "check": "scripts/check.sh"
  },
  "engines": {
    "node": ">=23.6",
    "pnpm": ">=11"
  }
}
