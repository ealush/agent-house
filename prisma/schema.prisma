// ah's durable state: sessions (the registry), side-chat subscriptions and
// history, recent prompts, and loose settings. One SQLite file per host at
// ~/.local/state/ah/ah.db (0600). Chat history is keyed by session uid with
// no foreign key, so it outlives the session's own row on purpose.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  uid            String  @id
  host           String  @default("")
  title          String  @default("")
  harness        String  @default("")
  harnessId      String?
  cwd            String  @default("")
  model          String?
  status         String  @default("idle")
  lifecycle      String  @default("live")
  pendingResume  Boolean @default(false)
  createdAt      Int     @default(0)
  lastActivityAt Int     @default(0)
  endedAt        Int?
  exitCode       Int?
  tmuxJson       String?
  metaJson       String  @default("{}")
}

model Snapshot {
  id            Int    @id @default(autoincrement())
  uid           String
  turn          Int
  commit        String
  kind          String @default("turn")
  promptExcerpt String @default("")
  branch        String @default("")
  createdAt     Int    @default(0)
  filesChanged  Int    @default(0)
  insertions    Int    @default(0)
  deletions     Int    @default(0)
  skippedJson   String @default("[]")
  submodules    Boolean @default(false)

  @@unique([uid, turn])
  @@index([uid, turn])
}

model ChatMessage {
  id   Int    @id @default(autoincrement())
  uid  String
  role String
  text String
  at   Int

  @@index([uid, id])
}

model Prompt {
  id   Int    @id @default(autoincrement())
  text String
  at   Int
}

model Subscription {
  id      String @id
  name    String
  baseUrl String
  model   String
  apiKey  String
}

model Setting {
  key   String @id
  value String
}

// One launch of a fleet recipe (issue #6). The snapshot is the recipe exactly
// as resolved at launch time, so editing the recipe never changes a live run.
// Members are the launched sessions, in recipe order.
model RecipeRun {
  runId        String  @id
  recipeId     String
  name         String  @default("")
  host         String  @default("")
  cwd          String  @default("")
  brief        String  @default("")
  state        String  @default("running")
  reason       String?
  createdAt    Int     @default(0)
  membersJson  String  @default("[]")
  snapshotJson String  @default("{}")
}

// A declarative handoff between two members of a run. State moves pending to
// delivered, cancelled (its queue item was cancelled) or skipped, and back to
// pending for repeat handoffs. `armed` records that the source has been seen
// working since the last fire, so a turn that ends while ah is down still
// fires exactly once when it comes back.
model Handoff {
  id          String  @id
  runId       String
  sourceUid   String
  targetUid   String
  sourceKey   String
  targetKey   String
  event       String
  template    String
  repeat      Boolean @default(false)
  state       String  @default("pending")
  armed       Boolean @default(false)
  queueId     String?
  deliveredAt Int?
  fires       Int     @default(0)
  reason      String?

  @@index([runId])
}
