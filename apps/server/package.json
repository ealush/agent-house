{
  "name": "ah",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Hub: a web control plane for persistent tmux shells and coding-agent sessions",
  "type": "module",
  "bin": {
    "ah": "./bin/ah.js"
  },
  "scripts": {
    "dev": "node --watch server/main.ts & vite",
    "build": "vite build",
    "start": "node server/main.ts",
    "serve": "node server/main.ts",
    "setup:tailscale": "node bin/ah.js setup tailscale",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/*.test.ts server/feed/*.test.ts test/*.test.ts test/security/*.test.ts",
    "test:security": "node --test test/security/*.test.ts",
    "test:ui": "node --test --test-concurrency=1 test/ui/*.test.ts",
    "prisma:check": "node scripts/prisma-check.mjs",
    "postinstall": "prisma generate --schema prisma/schema.prisma && node scripts/node-pty-helper.mjs"
  },
  "engines": {
    "node": ">=23.6",
    "pnpm": ">=11"
  },
  "dependencies": {
    "@fontsource-variable/rubik": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "@simplewebauthn/server": "^14.0.3",
    "node-pty": "^1.1.0",
    "web-push": "^3.6.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "playwright-core": "1.64.0",
    "prisma": "^6.19.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
