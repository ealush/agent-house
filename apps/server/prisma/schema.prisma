// ah's durable state: sessions (the registry), side-chat subscriptions and
// history, recent prompts, session environment variables, and loose
// settings. One SQLite file per host at ~/.local/state/ah/ah.db (0600). Chat history is keyed by session uid with
// no foreign key, so it outlives the session's own row on purpose.
//
// Full-text search (issue #9) adds FTS5 virtual tables (transcript_fts,
// chat_fts) and a SearchSource fingerprint table to the same file. Prisma
// cannot model FTS5, so they exist only in the migration SQL and in raw
// queries in server/search.ts; the search.enabled flag lives in Setting.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  uid            String  @id
  host           String  @default("")
  title          String  @default("")
  harness        String  @default("")
  harnessId      String?
  cwd            String  @default("")
  model          String?
  status         String  @default("idle")
  lifecycle      String  @default("live")
  pendingResume  Boolean @default(false)
  createdAt      Int     @default(0)
  lastActivityAt Int     @default(0)
  endedAt        Int?
  exitCode       Int?
  tmuxJson       String?
  metaJson       String  @default("{}")
}

model Snapshot {
  repoRoot      String @default("")
  id            Int    @id @default(autoincrement())
  uid           String
  turn          Int
  commit        String
  kind          String @default("turn")
  promptExcerpt String @default("")
  branch        String @default("")
  createdAt     Int    @default(0)
  filesChanged  Int    @default(0)
  insertions    Int    @default(0)
  deletions     Int    @default(0)
  skippedJson   String @default("[]")
  submodules    Boolean @default(false)

  @@unique([uid, turn])
  @@index([uid, turn])
}

model ChatMessage {
  id   Int    @id @default(autoincrement())
  uid  String
  role String
  text String
  at   Int
  /// Review threads: JSON of what a question pointed at (the layer, findings, diff lines, files).
  context String?

  @@index([uid, id])
}

model Prompt {
  id   Int    @id @default(autoincrement())
  text String
  at   Int
}

model Subscription {
  id      String @id
  name    String
  baseUrl String
  model   String
  apiKey  String
  /** Also handed to sessions as this environment variable (Settings → Environment). */
  envName String?
}

// Environment variables every session window starts with (tmux new-window -e).
// Secret values are never returned by the API once saved.
model EnvVar {
  name   String  @id
  value  String
  secret Boolean @default(true)
}

model Setting {
  key   String @id
  value String
}

// Stack review (docs/stack-review.md): a tree of PRs reviewed one layer at a
// time. GitHub stays the source of truth for PR state; these rows hold what
// GitHub doesn't: merge order, roles, revisions you reviewed, findings,
// what was sent to which agent, and decisions you accepted. Threads are
// ChatMessage rows keyed `review:<stack>` and `review:<stack>:<pr>`.
model ReviewStack {
  id          String  @id
  repoRoot    String
  repo        String
  trunk       String
  title       String
  planPath    String?
  ownerUid    String?
  ownerKey    String?
  mergeMethod String  @default("merge")
  /// "tree": the PRs GitHub's base links stack on the first one (new ones join); "manual": the PRs you picked, in your order;
  /// "native": a stack on GitHub (`ghStack`), whose PRs join and keep GitHub's order.
  source      String  @default("tree")
  ghStack     Int?
  /// The agent session that made the stack (uid, and its conversation key, which survives resumes): its transcript is the stack's why.
  originUid   String?
  originKey   String?
  state       String  @default("open")
  createdAt   Int     @default(0)
  syncedAt    Int     @default(0)
  syncError   String?
}

model ReviewLayer {
  stackId       String
  pr            Int
  position      Int
  role          String  @default("")
  state         String  @default("open")
  title         String  @default("")
  url           String  @default("")
  author        String  @default("")
  headRef       String  @default("")
  baseRef       String  @default("")
  headSha       String  @default("")
  baseSha       String  @default("")
  draft         Boolean @default(false)
  mergeable     String?
  checksJson    String  @default("{}")
  needs         String  @default("")
  currentRevId  Int?
  /// The revision you last reviewed (approved it, or sent findings against it): "since review" diffs from here.
  reviewedRevId Int?
  approved      Boolean @default(false)
  ownerUid      String?
  ownerKey      String?
  /// The GitHub stack this PR is in (the number GitHub shows) and its place there, 1 at the bottom. GitHub merges it with the PRs under it.
  ghStack       Int?
  ghPos         Int?

  @@id([stackId, pr])
}

model ReviewRevision {
  id          Int     @id @default(autoincrement())
  stackId     String
  pr          Int
  baseSha     String
  headSha     String
  patchId     String
  files       Int     @default(0)
  additions   Int     @default(0)
  deletions   Int     @default(0)
  summary     String?
  summaryAt   Int?
  verdictJson String?
  createdAt   Int     @default(0)

  @@unique([stackId, pr, baseSha, headSha])
  @@index([stackId, pr])
}

model ReviewFinding {
  id         Int     @id @default(autoincrement())
  stackId    String
  ownerPr    Int
  foundOnPr  Int
  revisionId Int?
  messageId  Int?
  path       String?
  lineStart  Int?
  lineEnd    Int?
  title      String
  body       String  @default("")
  severity   String  @default("should")
  source     String  @default("you")
  ghThread   String?
  ghUrl      String?
  state      String  @default("open")
  /// Who moved it to its state ("you", "reviewer", "github") and at which revision.
  stateBy    String?
  stateRevId Int?
  note       String?
  dispatchId Int?
  createdAt  Int     @default(0)
  updatedAt  Int     @default(0)

  @@index([stackId, ownerPr])
}

model ReviewDispatch {
  id          Int     @id @default(autoincrement())
  stackId     String
  pr          Int
  targetUid   String
  targetKey   String
  /// "fix": done when the layer's head moves; "merge": the stack merged up to this layer, done when it has.
  kind        String  @default("fix")
  text        String
  fromRevId   Int?
  fromHead    String  @default("")
  queueId     String?
  state       String  @default("sent")
  sawWork     Boolean @default(false)
  sentAt      Int     @default(0)
  doneAt      Int?

  @@index([stackId, state])
}

model ReviewDecision {
  id      Int    @id @default(autoincrement())
  stackId String
  text    String
  fromPr  Int?
  at      Int    @default(0)

  @@index([stackId])
}

// Portable conversations (docs/spec/13-conductor.md): ah's identity for a
// conversation across harnesses and hosts, and how conversations came from one
// another. The harness's transcript stays authoritative and is never rewritten;
// the portable document read from it is a JSON file under
// ~/.local/state/ah/portable/<id>/ (it can run to megabytes). `id` is
// `pc-` + a hash of `harness:harnessId`, the same on every host.
model Conversation {
  id          String @id
  harness     String
  harnessId   String
  /// The host whose transcript is authoritative now (a migration moves it).
  host        String @default("")
  title       String @default("")
  cwd         String @default("")
  sourceFile  String @default("")
  sourceBytes Int    @default(0)
  sourceSha   String @default("")
  /// The newest portable document written for it.
  docPath     String?
  docVersion  Int    @default(1)
  messages    Int    @default(0)
  createdAt   Int    @default(0)
  updatedAt   Int    @default(0)

  @@unique([harness, harnessId])
}

// One edge of a conversation's lineage, and the operation that made it: a fork, a
// continuation into another harness, a migration, an import. `state` is the
// operation's progress (preparing → launching → delivering → linked, or failed /
// cancelled); a row is written before anything is launched, so a restart finds
// work in flight. `idempotencyKey` makes a retried request return the same edge.
model ConversationLink {
  id              String  @id
  /// resume | fork | portable | migration | import
  kind            String
  /// native-resume | native-fork | ancestor-fork | context-handoff | transfer
  strategy        String
  state           String  @default("preparing")
  parentId        String
  childId         String?
  parentUid       String?
  /// The destination session's uid, chosen before it launches.
  childUid        String?
  fromHarness     String
  toHarness       String
  fromHost        String  @default("")
  toHost          String  @default("")
  /// Where the parent was read up to: its last line, byte length and the sha256 of those bytes.
  checkpointLine  Int?
  checkpointBytes Int?
  checkpointSha   String?
  limitationsJson String  @default("[]")
  /// Operation details (the portable documents used, the destination's launch, errors along the way).
  detailJson      String  @default("{}")
  error           String?
  idempotencyKey  String? @unique
  createdAt       Int     @default(0)
  updatedAt       Int     @default(0)

  @@index([parentId])
  @@index([childId])
  @@index([childUid])
}

// Moving a stopped session to another host (docs/spec/13-conductor.md, CND-3). The
// same table on both ends: `role` says which. The source keeps its conversation
// until the destination says it can resume it, and never deletes it on its own.
// state: planned → transferring → committing → verifying → completed, or failed /
// cancelled (rolled back on the destination).
model Migration {
  id             String  @id
  /// outgoing (this host is the source) | incoming (this host is the destination)
  role           String
  state          String  @default("planned")
  /// The other host's name: the destination for outgoing, the source for incoming.
  peer           String
  sourceUid      String?
  destUid        String?
  harness        String
  harnessId      String
  title          String  @default("")
  sourceCwd      String  @default("")
  destCwd        String?
  /// What moves and what it needs (no secrets: environment variables by name only).
  manifestJson   String  @default("{}")
  /// The destination's verdict before anything moved: requirements, warnings, conflicts.
  preflightJson  String  @default("{}")
  /// Per-file progress: { name: { bytes, sha256, sent } }.
  progressJson   String  @default("{}")
  error          String?
  idempotencyKey String? @unique
  createdAt      Int     @default(0)
  updatedAt      Int     @default(0)

  @@index([role, state])
}

// Scheduled and conditional agent work (docs/spec/13-conductor.md, CND-4). A Job is
// what to do and when; a JobRun is one time it ran. Job identity is not session
// identity: a run may start a session or speak to one. Everything needed to rebuild
// pending work after a restart is here.
// Job.state: scheduled | waiting (a run needs your decision) | paused | done | failed | cancelled
model Job {
  id          String  @id
  name        String
  state       String  @default("scheduled")
  /// What a run does: launch an agent with a prompt, send to a session, or wait for a decision.
  actionJson  String
  /// When: at a time, on a cron schedule in a time zone, after another job, or on a session event.
  triggerJson String
  /// Limits and follow-up: retries, timeout, max runs, concurrency key, notify.
  policyJson  String  @default("{}")
  nextRunAt   Int?
  runCount    Int     @default(0)
  /// Session events: when the trigger was armed, and what's been seen of the session since.
  armedAt     Int     @default(0)
  sawBusyAt   Int?
  lastFiredAt Int?
  createdBy   String  @default("")
  createdAt   Int     @default(0)
  updatedAt   Int     @default(0)

  @@index([state, nextRunAt])
}

// JobRun.state: eligible → running (dispatching → dispatched → observed) → succeeded,
// or failed / uncertain (delivery couldn't be confirmed or ruled out) / cancelled /
// skipped (a dependency didn't succeed) / waiting (a decision run, until you decide).
model JobRun {
  id             String  @id
  jobId          String
  seq            Int
  state          String  @default("eligible")
  /// Unique per cause (the schedule slot, the upstream run, the session event): a cause fires once.
  idempotencyKey String  @unique
  triggeredBy    String
  scheduledFor   Int     @default(0)
  attempt        Int     @default(1)
  /// Which process holds it, until when (a crashed holder's runs are reconciled).
  owner          String?
  leaseUntil     Int?
  /// The session the run started (chosen before it launches) or spoke to.
  sessionUid     String?
  /// Delivery facts: accepted, queued (queue item id = run id), typed, observed, finished; the transcript mark.
  deliveryJson   String  @default("{}")
  outcomeJson    String  @default("{}")
  error          String?
  startedAt      Int?
  endedAt        Int?
  createdAt      Int     @default(0)
  updatedAt      Int     @default(0)

  @@unique([jobId, seq])
  @@index([state])
  @@index([jobId])
}

// Keeping an agent going through temporary failures (docs/spec/13-conductor.md, CND-5).
// One row per conversation (`key` = harness:harnessId, or the uid) while something is
// wrong or being retried, kept after it's resolved for its history. Every decision the
// engine makes is a RecoveryEvent: why a retry was scheduled, what was done, what came of it.
// state: waiting_capacity | recoverable | scheduled | resuming | needs_user | failed | resolved | stopped
model Recovery {
  key           String  @id
  uid           String
  state         String
  /// rate_limit | provider_unavailable | network | process_exit | credentials | unknown
  reason        String
  /// What the agent said (or what ah saw), word for word, shortened.
  evidence      String  @default("")
  /// transcript | screen | lifecycle
  source        String  @default("")
  attempts      Int     @default(0)
  maxAttempts   Int     @default(5)
  nextAttemptAt Int?
  /// When the provider said capacity comes back (epoch seconds), when it said.
  resetsAt      Int?
  /// Transcript length when the failure was seen, and when the last attempt was made.
  markJson      String  @default("{}")
  /// The last attempt's continuation, its queue id and when.
  lastAttemptJson String @default("{}")
  createdAt     Int     @default(0)
  updatedAt     Int     @default(0)

  @@index([state, nextAttemptAt])
}

model RecoveryEvent {
  id     Int    @id @default(autoincrement())
  key    String
  at     Int
  state  String
  detail String

  @@index([key, id])
}

// What agents use (docs/spec/13-conductor.md, CND-6): tokens per conversation, model and
// day, read from the harnesses' own transcripts (local telemetry, not a bill), and the
// rate-limit windows they report. Bounded: rows older than `usage.retentionDays` go.
// Token counts are Float (exact to 2^53; a busy day of cache reads passes 2^31).
model UsageDaily {
  /// day|convKey|model
  id               String  @id
  /// UTC date, YYYY-MM-DD
  day              String
  host             String  @default("")
  convKey          String
  uid              String?
  harness          String
  /// anthropic | openai | google | xai | unknown
  provider         String
  model            String
  inputTokens      Float   @default(0)
  outputTokens     Float   @default(0)
  cacheReadTokens  Float   @default(0)
  cacheWriteTokens Float   @default(0)
  reasoningTokens  Float   @default(0)
  messages         Int     @default(0)
  updatedAt        Int     @default(0)

  @@index([day])
  @@index([convKey])
}

// How far each transcript has been read, so a pass reads only what's new.
model UsageCursor {
  file      String @id
  offset    Float  @default(0)
  ino       Float  @default(0)
  /// Recent message ids already counted (Claude repeats one message's usage per content block), and the current model.
  stateJson String @default("{}")
  updatedAt Int    @default(0)
}

// A rate-limit window as the provider reported it (Codex's own telemetry) or ah read it
// (a limit notice, an error line). Kept when it changes; 30 days.
model RateLimitSample {
  id            Int     @id @default(autoincrement())
  harness       String
  provider      String
  /// primary | secondary | session | weekly | usage
  window        String
  usedPercent   Float?
  windowMinutes Int?
  resetsAt      Int?
  /// provider_telemetry | screen | transcript
  source        String
  observedAt    Int

  @@index([harness, window, observedAt])
}

// Scratchpads (docs/spec/15-scratchpads.md): Markdown notes that are sessions of
// their own, with no agent, tmux window or process. The id is made on the device
// that wrote the note first (a UUID), so a note written offline keeps its identity
// once it reaches the host. Every write names the revision it was made on; one made
// on an older revision is refused (409), never applied over the newer text. A
// deleted note stays as a tombstone (no text), so a device that was offline can't
// bring it back. `seq` orders every change across notes, for `GET /api/notes?since=`.
model Note {
  id          String  @id
  title       String  @default("")
  markdown    String  @default("")
  /// The project it's filed under: a host's name (this one or a peer) and a folder there. Nothing is written into that folder.
  projectHost String?
  projectPath String?
  revision    Int     @default(1)
  seq         Int     @default(0)
  /// The last accepted write: a retried write with the same id is answered, not applied twice.
  lastWriteId String?
  /// Who wrote last ("device:<label>", "token:<name>", "local").
  writer      String  @default("")
  /// Seconds since the epoch.
  createdAt   Int     @default(0)
  updatedAt   Int     @default(0)
  deletedAt   Int?
  /// Where it was saved as a file, newest first: [{ host, path, revision, at }].
  exportsJson String  @default("[]")

  @@index([seq])
}

// A note handed to an agent session (`POST /api/notes/handoffs`): one row per hand-off,
// keyed by the id the device chose, written before the text goes anywhere. A retry with
// the same id answers what happened instead of sending again. The note's text isn't kept
// here, only which revision it was and its hash.
// state: sending → delivered | queued, or failed (nothing was typed) / uncertain (a crash mid-send)
model NoteHandoff {
  id        String  @id
  noteId    String
  revision  Int
  target    String
  textSha   String
  state     String  @default("sending")
  queueId   String?
  resumed   Boolean @default(false)
  error     String?
  createdAt Int     @default(0)
  updatedAt Int     @default(0)

  @@index([noteId])
}

// Concurrent agent workspaces (docs/spec/18-checkouts.md): one row per tracked
// repository checkout (the canonical main checkout or an ah-managed worktree).
// Exclusive writer ownership is enforced atomically on `ownerUid` inside SQLite
// write transactions so concurrent launches across web, native, CLI, jobs, fork,
// resume and recovery cannot assign two writers to one checkout.
model Checkout {
  id             String  @id
  repoRoot       String
  path           String  @unique
  /// main | worktree
  kind           String  @default("worktree")
  /// ah made this worktree for a session; only these are ever reclaimed automatically
  managed        Boolean @default(false)
  branch         String?
  baseSha        String  @default("")
  baseBranch     String  @default("")
  /// Exclusive active writing session uid; null when no writer owns it.
  ownerUid       String?
  /// active | retained | archived | reclaimed
  lifecycle      String  @default("active")
  pinned         Boolean @default(false)
  /// Allocated runtime port block (inclusive), null when released.
  portStart      Int?
  portEnd        Int?
  /// Disposable per-checkout temp directory, removed on reclamation.
  tempDir        String?
  /// Last observed git/integration summary JSON (changedFiles, mergeable, conflicts, ahead, dirty, merged).
  statusJson     String  @default("{}")
  createdAt      Int     @default(0)
  lastActivityAt Int     @default(0)
  archivedAt     Int?
  reclaimedAt    Int?

  @@index([repoRoot])
  @@index([ownerUid])
  @@index([lifecycle])
}
