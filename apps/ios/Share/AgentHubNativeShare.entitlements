<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The app's own Keychain group (its application identifier), so the share extension
         reads the sign-ins the app keeps (it never writes them). Any team-prefixed group is
         in every provisioning profile; it needs no App ID capability. -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)$(AH_BUNDLE_IDENTIFIER)</string>
    </array>
</dict>
</plist>
